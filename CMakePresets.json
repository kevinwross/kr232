{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64, MSVC, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-wsl",
      "displayName": "Linux x64, GCC, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-wsl",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64, GCC, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "jobs": 10 },
    { "name": "linux-wsl", "configurePreset": "linux-wsl", "jobs": 10 },
    { "name": "linux-arm64", "configurePreset": "linux-arm64", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    },
    {
      "name": "linux-wsl",
      "configurePreset": "linux-wsl",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    }
  ]
}
